# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_APP_URL: Your Vercel production URL (or custom domain).
# This is used as the base URL for Supabase password-reset email links.
# REQUIRED: Must also be whitelisted in Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
# Add pattern: https://your-vercel-app.vercel.app/** (the ** allows any path)
VITE_APP_URL="https://your-vercel-app.vercel.app"

# Supabase Client Credentials: Used in browser for public / anon access.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Server Privileged Credentials: Required for backend server operations (bypasses RLS). Never expose to browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis: Used for distributed rate limiting and state across instances.
REDIS_URL="redis://localhost:6379"


# Firebase Credentials: Required for Firebase Auth and Firestore.
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""
