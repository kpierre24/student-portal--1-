{
  "name": "hteim-school-of-ministry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/post-build.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host",
    "clean": "rm -rf dist build server.js",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:health": "node scripts/maintenance/db-health-check.cjs",
    "db:seed": "node scripts/seed/seed-academic-data.cjs",
    "db:validate-constraints": "node scripts/ci/validate-constraints.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docker:build": "docker build -t hteim-school-of-ministry .",
    "docker:run": "docker run -d -p 3000:3000 --name hteim-school-of-ministry hteim-school-of-ministry",
    "docker:compose": "docker compose up --build -d",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:bundle:release": "node scripts/build-android-aab.cjs",
    "android:bundle": "node scripts/build-android-aab.cjs",
    "cap:build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.3.289",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "redis": "^6.2.1",
    "sonner": "^2.0.8",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "video.js": "^8.24.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/string-similarity": "^4.0.2",
    "@types/supertest": "^7.2.1",
    "@types/video.js": "^7.3.58",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
